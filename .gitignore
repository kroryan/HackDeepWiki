# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# PyInstaller/setuptools build output in any subproject. The top-level
# /build/ is NOT ignored here: it holds the versioned component manifest
# (see the "production" section below).
api/build/
develop-eggs/
dist/
downloads/
eggs/
api/logs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.venv
# testing
/.coverage
/coverage
/coverage.xml

# next.js
/.next/
/out/

# production
/build/*
!/build/components.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/

# ignore adding self-signed certs
certs/

# Local HackDeepWiki/Ollama runtime state
/.hackdeepwiki/
/.freedeepwiki/
/.deepwiki/
/hackdeepwiki.env
/freedeepwiki.env

# Standalone build directories
/bin/
/tiktoken_cache/
/AppDir/
/*.AppImage
/appimagetool*
/appimage-runtime-*

/.venv311/
DATABASE/

# scratch/local-only tooling (e.g. kiwix-desktop clone used for .zim research)
/tmp/

# stale config backups
*.bak

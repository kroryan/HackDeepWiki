# Generated by scripts/generate_env_example.py.
# Copy to hackdeepwiki.env and change only the settings you need.
# This example is secure for the Docker/LAN launcher by default.

# Provider/runtime helpers
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_EMBED_BATCH_SIZE=32
OLLAMA_REQUEST_TIMEOUT=1800
OLLAMA_HEALTH_TIMEOUT=60
GITHUB_TOKEN=

# HackDeepWiki settings
# desktop or trusted-lan
HACKDEEPWIKI_DEPLOYMENT_PROFILE=trusted-lan
# Backend bind host
HACKDEEPWIKI_HOST=0.0.0.0
# Enable shared-code authentication
HACKDEEPWIKI_AUTH_MODE=true
# Shared secret (minimum 16 chars off loopback)
HACKDEEPWIKI_AUTH_CODE=replace-with-a-long-random-secret
# Signed browser-session lifetime
# HACKDEEPWIKI_AUTH_SESSION_SECONDS=
# Comma-separated extra browser origins
# HACKDEEPWIKI_ALLOWED_ORIGINS=
# OS-path-separated local repository roots
# HACKDEEPWIKI_ALLOWED_LOCAL_ROOTS=
# Unsafe isolated-network escape hatch
# HACKDEEPWIKI_ALLOW_INSECURE_REMOTE=
# Persistent data root
# HACKDEEPWIKI_DATA_DIR=
# Model configuration directory
# HACKDEEPWIKI_CONFIG_DIR=
# Provider-profile encryption passphrase
# HACKDEEPWIKI_ENC_KEY=
# Explicit MCP bearer token
# HACKDEEPWIKI_MCP_TOKEN=
# Outbound policy: any or public
# HACKDEEPWIKI_EGRESS_POLICY=
# Explicit OpenCode executable path
# HACKDEEPWIKI_OPENCODE_BIN=
# Repository embedding provider
# HACKDEEPWIKI_EMBEDDER_TYPE=
# Enable shared Engraphis embedder
# HACKDEEPWIKI_ENGRAPHIS_EMBEDDER=
# Disable iterative agent tools
# HACKDEEPWIKI_DISABLE_AGENT_LOOP=
# Research iteration bound
# HACKDEEPWIKI_DEEP_RESEARCH_MAX_ITERATIONS=
# Code-context chunk size
# HACKDEEPWIKI_CODE_CHUNK_CHARS=
# Maximum code-context block
# HACKDEEPWIKI_CODE_MAX_BLOCK_CHARS=
# Code-context overlap
# HACKDEEPWIKI_CODE_OVERLAP_LINES=
# Durable job retry limit
# HACKDEEPWIKI_JOB_MAX_ATTEMPTS=
# Durable job retry backoff
# HACKDEEPWIKI_JOB_BACKOFF_BASE=
# Worker polling interval
# HACKDEEPWIKI_JOB_POLL=
# Stale running-job recovery age
# HACKDEEPWIKI_JOB_STALE_SECONDS=
# External MCP discovery timeout
# HACKDEEPWIKI_MCP_LIST_TIMEOUT=
# External MCP request timeout
# HACKDEEPWIKI_MCP_STDIO_TIMEOUT=
# Optional vulnerability graph URI
# HACKDEEPWIKI_NEO4J_URI=
# Optional vulnerability graph user
# HACKDEEPWIKI_NEO4J_USER=
# Optional vulnerability graph password
# HACKDEEPWIKI_NEO4J_PASSWORD=
# Bundled Ollama operating mode
# HACKDEEPWIKI_OLLAMA_MODE=
# Cache retention age
# HACKDEEPWIKI_WIKI_CACHE_MAX_AGE_DAYS=
# Cache retention size
# HACKDEEPWIKI_WIKI_CACHE_MAX_BYTES=
# Cache retention file count
# HACKDEEPWIKI_WIKI_CACHE_MAX_FILES=
# Authentication failure limit
# HACKDEEPWIKI_AUTH_MAX_FAILED=
# Authentication lockout window
# HACKDEEPWIKI_AUTH_LOCKOUT_WINDOW=
# Docker Compose project name
HACKDEEPWIKI_PROJECT_NAME=hackdeepwiki-local
# Docker launcher network mode
HACKDEEPWIKI_NETWORK_MODE=auto
# Preferred backend port
HACKDEEPWIKI_API_PORT=8001
